# --- Credentials (only needed when DRY_RUN=false) ---
POLYMARKET_PRIVATE_KEY=
POLYMARKET_API_KEY=
POLYMARKET_API_SECRET=
POLYMARKET_API_PASSPHRASE=
POLYMARKET_FUNDER=            # your Deposit Wallet address (Polymarket only accepts API orders from Deposit Wallets)
POLYMARKET_SIGNATURE_TYPE=3   # 3 = Deposit Wallet
POLYMARKET_BUILDER_API_KEY=   # builder key: pays for gasless wallet transactions
POLYMARKET_BUILDER_SECRET=
POLYMARKET_BUILDER_PASSPHRASE=
CHAIN_ID=

# --- Run mode ---
DRY_RUN=true
PAPER_BANKROLL_USDC=100
TIMEFRAMES=5m,15m
DASHBOARD_PORT=8050   # 0 disables the dashboard

# --- Entry gates: only trades the model rates >= 90% AND that are cheap enough after fees ---
MIN_WIN_PROBABILITY=0.90
MIN_ENTRY_PRICE=0.85
MAX_ENTRY_PRICE=0.97
MIN_NET_EDGE=0.02
MODEL_HAIRCUT=0.02
VOL_MULTIPLIER=1.25
MIN_DISTANCE_USD=25
MIN_SECONDS_LEFT=8
MAX_SECONDS_LEFT_5M=90
MAX_SECONDS_LEFT_15M=240

# --- Sizing / risk ---
KELLY_FRACTION=0.25
MIN_TRADE_USDC=5
MAX_TRADE_USDC=25
MAX_OPEN_EXPOSURE_USDC=50
DAILY_LOSS_LIMIT_USDC=50

# --- Fees (fallback only; the market's own feeSchedule is used when present) ---
FALLBACK_FEE_RATE=0.07
